<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="BloodborneLauncher.PatchManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BloodborneLauncher.Models"
    Title="XML patches"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">960</x:Double>
    </ContentDialog.Resources>
    <Grid Width="760" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Community patches from patches\Bloodborne.xml (game version 01.09). Effects such as motion blur, depth of field and Skip Intro are set on the main page." />
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search name, author or note" QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
            <ComboBox x:Name="CategoryBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnCategoryChanged" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Select visible" Click="OnSelectVisible" />
            <Button Grid.Column="1" Content="Deselect visible" Click="OnDeselectVisible" />
            <Button Grid.Column="2" Content="Recommended defaults" Click="OnRecommended" />
            <TextBlock x:Name="CountText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource GroupStyle}" Height="440">
            <ListView x:Name="PatchList" SelectionMode="None" Padding="0,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PatchItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <Run Text="{x:Bind AuthorText}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasNote}" />
                            </StackPanel>
                            <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0" Padding="8,2" CornerRadius="10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</ContentDialog>
